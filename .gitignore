# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# build outputs
build
dist

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# worktrees
.worktrees/
.claude/worktrees/

# Browser automation profiles and local captures may contain cookies,
# passwords, session storage, and other credentials.
.codex-browser-shots/
**/Default/
*.sqlite
*.sqlite-journal

# Supabase CLI link metadata is machine-local and may disclose project details.
supabase/.temp/

# env files (commit .env.example only)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript / tooling caches
*.tsbuildinfo
apps/web/next-env.d.ts
.turbo
.eslintcache

/generated/prisma

# CloudFront origin verification secret written by infra/aws/provision-cloudfront.sh
origin-verify-secret.txt

# Security audit reports. This repository is public, and these contain working
# exploit paths for vulnerabilities that are still open in production. Committing
# one publishes it. Share them out of band.
# Deliberately loose: copies get suffixed by hand (-report-1.md, -report1.md),
# and those did not match a trailing "-report.md" pattern.
voiceforge-*report*.md
VOICEFORGE_AUDIT_REPORT.md
