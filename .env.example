# ==========================================================================
# VoiceForge AI — environment variables
# Copy to .env at the repo root. Both apps read from this file via dotenv.
# ==========================================================================

# ---- Runtime mode ---------------------------------------------------------
NODE_ENV=development

# ---- API server -----------------------------------------------------------
API_PORT=4000
WEB_PORT=3000

# ---- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:4000

# ---- Supabase Auth --------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Supabase Postgres ----------------------------------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=

# ---- Internal API (shared secret between trusted services and NestJS) -------
INTERNAL_API_KEY=your-random-secret-at-least-32-chars-here
# Next.js server-side auth proxy target.
INTERNAL_API_URL=http://localhost:4000
# LiveKit worker knowledge-retrieval target. Production compose sets this to the
# private http://api:4000 service so retrieval never leaves the Docker network.
INTERNAL_API_BASE_URL=http://localhost:4000

# ---- Authentication ------------------------------------------------------
AUTH_PROVIDER=supabase
SUPABASE_JWT_SECRET=

# ---- Supabase Storage -----------------------------------------------------
SUPABASE_KNOWLEDGE_BUCKET=knowledge-files
SUPABASE_STORAGE_BUCKET=voiceforge

# ---- Valkey / Redis -------------------------------------------------------
REDIS_URL=
# Keep false on web/API instances. Run dedicated worker instances with true.
WORKERS_ENABLED=false

# ---- Voice providers ------------------------------------------------------
# Choose: mock (development only) | twilio | openai-realtime
# BREAKING (2026-08): vapi and retell were removed. A deployment that still sets
# VOICE_PROVIDER=vapi or retell keeps booting — the value is coerced to
# openai-realtime and a deprecation warning names the variables to delete — but
# VAPI_* and RETELL_* are no longer read at all. See docs/RUNBOOK.md §2.
VOICE_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER_PREFIX=+1
TWILIO_SIP_DOMAIN=
TWILIO_TWIML_WEBHOOK_URL=
TWILIO_STATUS_WEBHOOK_URL=
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_HOST=your-livekit-sip-host.sip.livekit.cloud
LIVEKIT_WEBHOOK_SECRET=
LIVEKIT_ROOM_PREFIX=call
LIVEKIT_AGENT_NAME_PREFIX=voiceforge-agent
VOBIZ_WEBHOOK_SECRET=
VOBIZ_DEFAULT_SIP_DOMAIN=
OPENAI_REALTIME_BASE_URL=https://api.openai.com/v1
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin

# ---- In-house voice pipeline (Azure STT -> LLM -> TTS) --------------------
# The "standard" pipeline: the only runtime the free plan may use, and half of
# starter-plan calls. Paid tiers stay on OpenAI Realtime. While this is false,
# every plan falls back to Realtime, so no call can land on a half-configured
# pipeline. In production, turning it on requires AZURE_OPENAI_ENDPOINT,
# AZURE_OPENAI_API_KEY, AZURE_VOICE_LLM_DEPLOYMENT, AZURE_SPEECH_KEY and
# AZURE_SPEECH_REGION, or the API refuses to boot.
VOICE_STANDARD_PIPELINE_ENABLED=false
# Azure OpenAI resource hosting the voice brain, e.g.
# https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Data-plane API version. Only set to override the pinned default used by the
# agent worker; a floating version can change tool-calling behavior mid-release.
AZURE_OPENAI_API_VERSION=
# Deployment name of the chat model acting as the voice brain.
AZURE_VOICE_LLM_DEPLOYMENT=
# Azure AI Speech resource used for streaming recognition and synthesis.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICE=en-US-AvaMultilingualNeural

# ---- LLM ------------------------------------------------------------------
# Choose: openai | github | anthropic | azure-aifoundry | mock | local
# azure-aifoundry (gpt-5.4-mini) is the production default.
LLM_PROVIDER=azure-aifoundry
LLM_MODEL=gpt-5.4-mini
# Azure AI Foundry OpenAI v1 endpoint or Cloudflare AI Gateway route, e.g.
# https://<resource>.services.ai.azure.com/openai/v1 or
# https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/azure-openai/<resource>/<deployment>
# Required in production when LLM_PROVIDER=azure-aifoundry.
LLM_BASE_URL=
LLM_API_KEY=
# Optional Azure API version, appended as ?api-version=... (e.g. 2025-01-01-preview).
# Leave empty for Foundry /openai/v1 endpoints, which do not use it.
LLM_API_VERSION=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
GITHUB_TOKEN=

# ---- Chat-to-agent generation ----------------------------------------------
# Generation jobs run in the BullMQ worker; at least one instance must run with
# WORKERS_ENABLED=true or chat generation requests will never be processed.
# Per-user generation rate limit (requests per window).
AGENT_GEN_RATE_LIMIT_MAX=10
AGENT_GEN_RATE_LIMIT_WINDOW_SECONDS=300
# Concurrent generation jobs per worker instance.
AGENT_GEN_WORKER_CONCURRENCY=4
# Sessions stuck 'generating' longer than this are failed so the UI can retry.
AGENT_GEN_STALE_AFTER_SECONDS=180

# ---- Embeddings -----------------------------------------------------------
EMBEDDING_PROVIDER=openai

# ---- Billing --------------------------------------------------------------
# Checkout and the Customer Portal turn on only when the secret key, webhook
# secret, both subscription prices and the minute-pack price are all present.
# A partially configured deployment reports BILLING_UNAVAILABLE; it never grants
# a recurring free allowance. When these are set, WEB_BASE_URL must be an
# absolute non-local HTTPS URL because Stripe redirects customers back to it.
# Distributed connecting + connected call capacity. Redis failures block new calls.
BILLING_GLOBAL_CONCURRENCY=100
BILLING_LEASE_TTL_SECONDS=90
# Stripe live/test secret key. Required for all billing endpoints.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...). Required to verify webhook signatures.
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs for each paid plan (one price per plan, monthly).
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
# One-time Price ID for the 100-minute prepaid pack ($39).
STRIPE_MINUTE_PACK_PRICE_ID=
# Stripe Tax stays off until tax registrations are confirmed.
STRIPE_TAX_ENABLED=false
# Public sales email surfaced by the pricing page's Contact sales CTA.
NEXT_PUBLIC_SALES_EMAIL=sales@voiceforge.ai

# ---- Billing operations ---------------------------------------------------
# See docs/operations/billing-runbook.md for alert thresholds and procedures.
# How often the reconciliation worker runs. Requires WORKERS_ENABLED=true on at
# least one instance, otherwise balance drift and leaked reservations are never
# repaired.
BILLING_RECONCILIATION_CRON="*/15 * * * *"
# Assumed variable cost per connected minute. Used to record a provider cost
# estimate before the provider reports actual usage, so margin dashboards are
# never blank. Raising this lowers reported margin; it does not change what a
# customer is charged.
BILLING_VARIABLE_COST_RESERVE_USD_PER_MINUTE=0.12
# Maximum rows touched per reconciliation job. A backlog is drained across
# successive runs rather than in one long-running transaction.
BILLING_RECONCILIATION_BATCH_SIZE=100
# A dispatched call that never reported a connection is finalized and its
# reserved credit released after this many minutes.
BILLING_STALE_CALL_TIMEOUT_MINUTES=30
# Free-plan monthly allowance sweep. Runs daily rather than monthly because the
# grant is idempotent per organization per calendar month, so an organization
# that signs up mid-month gets its minutes the same day. Requires
# WORKERS_ENABLED=true on at least one instance, otherwise free organizations
# are never granted minutes and cannot even run a browser test.
FREE_CREDIT_GRANT_CRON="15 0 * * *"

# ---- Email ----------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=VoiceForge <noreply@voiceforge.ai>
WEB_BASE_URL=http://localhost:3000

# ---- Google OAuth ---------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Security -------------------------------------------------------------
ENCRYPTION_KEY=
JWT_SECRET=change-me-in-production
DEFAULT_COUNTRY=US

# ---- Rate limiting --------------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Observability --------------------------------------------------------
METRICS_SCRAPE_TOKEN=
VOICE_WEBHOOK_SECRET=

# ---- PostHog (product analytics) ------------------------------------------
# The two tiers are gated independently: POSTHOG_ENABLED + POSTHOG_PROJECT_TOKEN
# control the server (NestJS) SDK only, and NEXT_PUBLIC_POSTHOG_ENABLED +
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN control the browser SDK only. Turning one
# tier off never affects the other; each tier needs its own flag AND token.
# PostHog never gates auth, billing, compliance or the call path.
# Server-side (NestJS) kill switch.
POSTHOG_ENABLED=false
# Browser (Next.js) kill switch. Separate from POSTHOG_ENABLED on purpose so the
# browser SDK can be turned off without stopping trusted server-side events.
# Inlined at build time, so changing it requires a web rebuild.
NEXT_PUBLIC_POSTHOG_ENABLED=false
# Project token from PostHog → Project settings. Use a DEVELOPMENT project here;
# never reuse the production project token and never use a personal API key.
# The NEXT_PUBLIC_ token is intentionally exposed to the browser.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
POSTHOG_PROJECT_TOKEN=
# Region-matched ingestion host: https://us.i.posthog.com or https://eu.i.posthog.com
# The browser never contacts this host directly — it is only used to build the
# same-origin proxy rewrite destinations in apps/web/next.config.ts.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
# Mirror 4xx API responses to error tracking in addition to 5xx.
# Off by default: an expired session produces a 401 on every in-flight request
# and route probing produces a steady stream of 404s, which would bury genuine
# server faults. Turn on temporarily to debug a client integration. 5xx is
# always captured regardless of this setting.
POSTHOG_CAPTURE_CLIENT_ERRORS=false
# Release metadata registered as super properties on browser events. No user data.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=dev
