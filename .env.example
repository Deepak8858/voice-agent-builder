# ==========================================================================
# VoiceForge AI — environment variables
# Copy to .env at the repo root. Both apps read from this file via dotenv.
# ==========================================================================

# ---- Runtime mode ---------------------------------------------------------
NODE_ENV=development

# ---- API server -----------------------------------------------------------
API_PORT=4000
WEB_PORT=3000

# ---- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:4000

# ---- Supabase Auth --------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Supabase Postgres ----------------------------------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=

# ---- Internal API (shared secret between trusted services and NestJS) -------
INTERNAL_API_KEY=your-random-secret-at-least-32-chars-here
# Next.js server-side auth proxy target.
INTERNAL_API_URL=http://localhost:4000
# LiveKit worker knowledge-retrieval target. Production compose sets this to the
# private http://api:4000 service so retrieval never leaves the Docker network.
INTERNAL_API_BASE_URL=http://localhost:4000

# ---- Authentication ------------------------------------------------------
AUTH_PROVIDER=supabase
SUPABASE_JWT_SECRET=

# ---- Supabase Storage -----------------------------------------------------
SUPABASE_KNOWLEDGE_BUCKET=knowledge-files
SUPABASE_STORAGE_BUCKET=voiceforge

# ---- Valkey / Redis -------------------------------------------------------
REDIS_URL=
# Keep false on web/API instances. Run dedicated worker instances with true.
WORKERS_ENABLED=false

# ---- Voice providers ------------------------------------------------------
# Choose: mock (development only) | vapi | twilio | openai-realtime | retell
VOICE_PROVIDER=mock
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_PHONE_NUMBER_ID=
RETELL_API_KEY=
RETELL_BASE_URL=https://api.retellai.com
RETELL_FROM_NUMBER=
RETELL_VOICE_ID=11labs-Adrian
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER_PREFIX=+1
TWILIO_SIP_DOMAIN=
TWILIO_TWIML_WEBHOOK_URL=
TWILIO_STATUS_WEBHOOK_URL=
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_HOST=your-livekit-sip-host.sip.livekit.cloud
LIVEKIT_WEBHOOK_SECRET=
LIVEKIT_ROOM_PREFIX=call
LIVEKIT_AGENT_NAME_PREFIX=voiceforge-agent
VOBIZ_WEBHOOK_SECRET=
VOBIZ_DEFAULT_SIP_DOMAIN=
OPENAI_REALTIME_BASE_URL=https://api.openai.com/v1
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin

# ---- LLM ------------------------------------------------------------------
# Choose: openai | github | anthropic | azure-aifoundry | mock | local
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
GITHUB_TOKEN=
LLM_API_KEY=
LLM_BASE_URL=
LLM_API_VERSION=2024-02-01

# ---- Embeddings -----------------------------------------------------------
EMBEDDING_PROVIDER=openai

# ---- Billing --------------------------------------------------------------
# demo disables live Stripe checkout/portal actions while keeping free-trial limits active.
# Set to live only when Stripe keys and price IDs are ready.
BILLING_MODE=demo
# Distributed connecting + connected call capacity. Redis failures block new calls.
BILLING_GLOBAL_CONCURRENCY=100
BILLING_LEASE_TTL_SECONDS=90
# Stripe live/test secret key. Required for all billing endpoints.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...). Required to verify webhook signatures.
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs for each paid plan (one price per plan, monthly).
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
# Public sales email surfaced by the pricing page's Contact sales CTA.
NEXT_PUBLIC_SALES_EMAIL=sales@voiceforge.ai

# ---- Billing operations ---------------------------------------------------
# See docs/operations/billing-runbook.md for alert thresholds and procedures.
# Assumed variable cost per connected minute. Used to record a provider cost
# estimate before the provider reports actual usage, so margin dashboards are
# never blank. Raising this lowers reported margin; it does not change what a
# customer is charged.
BILLING_VARIABLE_COST_RESERVE_USD_PER_MINUTE=0.12
# How often the reconciliation worker runs. Requires WORKERS_ENABLED=true on at
# least one instance, otherwise balance drift and leaked reservations are never
# repaired.
BILLING_RECONCILIATION_CRON=*/15 * * * *
# Maximum rows touched per reconciliation job. A backlog is drained across
# successive runs rather than in one long-running transaction.
BILLING_RECONCILIATION_BATCH_SIZE=100
# A dispatched call that never reported a connection is finalized and its
# reserved credit released after this many minutes.
BILLING_STALE_CALL_TIMEOUT_MINUTES=30

# ---- Email ----------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=VoiceForge <noreply@voiceforge.ai>
WEB_BASE_URL=http://localhost:3000

# ---- Google OAuth ---------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Security -------------------------------------------------------------
ENCRYPTION_KEY=
JWT_SECRET=change-me-in-production
DEFAULT_COUNTRY=US

# ---- Rate limiting --------------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Observability --------------------------------------------------------
METRICS_SCRAPE_TOKEN=
VOICE_WEBHOOK_SECRET=

# ---- PostHog (product analytics) ------------------------------------------
# The two tiers are gated independently: POSTHOG_ENABLED + POSTHOG_PROJECT_TOKEN
# control the server (NestJS) SDK only, and NEXT_PUBLIC_POSTHOG_ENABLED +
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN control the browser SDK only. Turning one
# tier off never affects the other; each tier needs its own flag AND token.
# PostHog never gates auth, billing, compliance or the call path.
# Server-side (NestJS) kill switch.
POSTHOG_ENABLED=false
# Browser (Next.js) kill switch. Separate from POSTHOG_ENABLED on purpose so the
# browser SDK can be turned off without stopping trusted server-side events.
# Inlined at build time, so changing it requires a web rebuild.
NEXT_PUBLIC_POSTHOG_ENABLED=false
# Project token from PostHog → Project settings. Use a DEVELOPMENT project here;
# never reuse the production project token and never use a personal API key.
# The NEXT_PUBLIC_ token is intentionally exposed to the browser.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
POSTHOG_PROJECT_TOKEN=
# Region-matched ingestion host: https://us.i.posthog.com or https://eu.i.posthog.com
# The browser never contacts this host directly — it is only used to build the
# same-origin proxy rewrite destinations in apps/web/next.config.ts.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
# Release metadata registered as super properties on browser events. No user data.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=dev
