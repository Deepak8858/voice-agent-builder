  sipAuthPasswordEncrypted Json?    @map("sip_auth_password_encrypted")
  status                   String   @default("pending")
  errorMessage             String?  @map("error_message")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneNumber  TelephonyPhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  agent        Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([organizationId])
  @@index([agentId])
  @@map("livekit_telephony_configs")
}

model TelephonyWebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  provider       String
  eventId        String    @map("event_id")
  eventType      String    @map("event_type")
  phoneNumberId  String?   @map("phone_number_id") @db.Uuid
  callId         String?   @map("call_id") @db.Uuid
  rawPayloadJson Json      @map("raw_payload_json")
  signatureValid Boolean   @default(false) @map("signature_valid")
  processedAt    DateTime? @map("processed_at")
  status         String    @default("received")
  errorMessage   String?   @map("error_message")
  workspaceId    String?   @map("workspace_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  phoneNumber TelephonyPhoneNumber? @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  workspace   Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([phoneNumberId])
  @@index([callId])
  @@index([workspaceId])
  @@index([provider, eventType])
  @@map("telephony_webhook_events")
}

// Outbound Campaigns
model OutboundCampaign {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  agentId     String   @map("agent_id") @db.Uuid
  name        String
  contacts    Json     @default("[]")
  schedule    Json     @default("{\"max_calls_per_hour\": 10, \"max_concurrent\": 3}")
  status      String   @default("draft") // draft | running | paused | completed | failed
  stats       Json     @default("{\"total\": 0, \"completed\": 0, \"failed\": 0, \"in_progress\": 0}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id])

  @@index([workspaceId])
  @@index([agentId])
  @@map("outbound_campaigns")
}
