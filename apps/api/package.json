{
  "name": "@voiceforge/api",
  "version": "0.1.0",
  "private": true,
  "description": "VoiceForge AI NestJS backend.",
  "scripts": {
    "dev": "nodemon",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:seed": "node -r @swc-node/register prisma/seed.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "db:role-check": "tsx scripts/db-role-check.ts",
    "db:enable-rls": "tsx scripts/db-enable-rls.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-express": "^11.1.29",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.112.2",
    "@types/cors": "^2.8.19",
    "@types/helmet": "^0.0.48",
    "@voiceforge/shared": "workspace:*",
    "bullmq": "^6.0.10",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.10",
    "livekit-server-sdk": "2.17.0",
    "pino": "^10.3.1",
    "posthog-node": "^5.48.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "22.4.0",
    "twilio": "6.0.2",
    "unpdf": "^1.8.0",
    "uuid": "^14.0.1",
    "ws": "8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.30",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.0.0",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^2.1.1"
  }
}
