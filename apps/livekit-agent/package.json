{
  "name": "@voiceforge/livekit-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VoiceForge LiveKit Agents runtime for SIP inbound and outbound calls.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js start",
    "dev": "node dist/index.js dev",
    "test": "vitest run"
  },
  "dependencies": {
    "@livekit/agents": "1.5.5",
    "@livekit/agents-plugin-azure": "1.5.5",
    "@livekit/agents-plugin-openai": "1.5.5",
    "@livekit/agents-plugin-silero": "1.5.5",
    "@livekit/rtc-node": "0.13.31",
    "@prisma/client": "^5.22.0",
    "@voiceforge/shared": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": "^20.20.0 || >=22.22.0"
  }
}
