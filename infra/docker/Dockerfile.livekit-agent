# syntax=docker/dockerfile:1.7
# NODE PIN: deliberately still 20.20.0 while the quality-gate workflows run
# NODE_VERSION 22.22. See the same note in Dockerfile.api: the workflows moved
# for jsdom 30 / markAsUncloneable, which nothing in this image uses. Both
# versions satisfy the root package.json engines ("^20.20.0 || >=22.22.0").
# Node 20 is end-of-life as of 2026-04-30, so this image still needs its own
# bump.
FROM --platform=linux/amd64 node:20.20.0-bookworm-slim AS build

WORKDIR /app
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ openssl \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@10.33.2 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/livekit-agent/package.json apps/livekit-agent/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json

RUN --mount=type=cache,id=voiceforge-pnpm,target=/pnpm/store,sharing=locked \
    pnpm config set store-dir /pnpm/store --global \
    && pnpm install --frozen-lockfile --ignore-scripts --node-linker=hoisted

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/api/prisma apps/api/prisma
COPY apps/livekit-agent apps/livekit-agent

RUN pnpm exec prisma generate --schema=apps/api/prisma/schema.prisma \
    && pnpm --filter @voiceforge/shared run build \
    && pnpm --filter @voiceforge/livekit-agent run build

FROM --platform=linux/amd64 node:20.20.0-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production

RUN apt-get update \
    && apt-get install -y --no-install-recommends tini openssl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 voiceforge \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin voiceforge

COPY --from=build --chown=10001:10001 /app/node_modules node_modules
# Same reason as Dockerfile.api: the @voiceforge/shared link and any
# un-hoistable dependency live in the package's own node_modules.
COPY --from=build --chown=10001:10001 /app/apps/livekit-agent/node_modules apps/livekit-agent/node_modules
COPY --from=build --chown=10001:10001 /app/apps/livekit-agent/dist apps/livekit-agent/dist
COPY --from=build --chown=10001:10001 /app/apps/livekit-agent/package.json apps/livekit-agent/package.json
COPY --from=build --chown=10001:10001 /app/apps/api/prisma apps/api/prisma
COPY --from=build --chown=10001:10001 /app/packages/shared/dist packages/shared/dist
COPY --from=build --chown=10001:10001 /app/packages/shared/package.json packages/shared/package.json

USER voiceforge
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["node", "-e", "process.kill(1,0)"]
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "apps/livekit-agent/dist/index.js", "start"]
