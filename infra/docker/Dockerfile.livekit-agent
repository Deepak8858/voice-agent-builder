# =============================================================================
# VoiceForge AI — LiveKit Agent Container
# =============================================================================
# Build context: repository root (monorepo)
#
# Installs with pnpm and a FROZEN lockfile so the image ships exactly the
# dependency graph CI audited. `pnpm.overrides` (where the transitive security
# patches live) is invisible to npm, so an npm install here would silently
# reintroduce the vulnerable versions.
# ---------------------------------------------------------------------------

FROM --platform=linux/amd64 node:20-slim AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ openssl \
    && rm -rf /var/lib/apt/lists/*

# Pin pnpm via corepack; the version comes from packageManager in package.json.
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

# --frozen-lockfile requires every manifest named by pnpm-workspace.yaml.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY apps/livekit-agent/package.json ./apps/livekit-agent/
COPY apps/voice-edge/package.json ./apps/voice-edge/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/ui/package.json ./packages/ui/

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store --global && \
    pnpm install --frozen-lockfile --ignore-scripts --node-linker=hoisted

COPY packages/shared ./packages/shared
COPY apps/api/prisma ./apps/api/prisma
COPY apps/livekit-agent ./apps/livekit-agent
COPY tsconfig.base.json ./

RUN pnpm exec prisma generate --schema=apps/api/prisma/schema.prisma
RUN pnpm --filter @voiceforge/shared run build
RUN pnpm --filter @voiceforge/livekit-agent run build

FROM --platform=linux/amd64 node:20-slim AS production

WORKDIR /app
ENV NODE_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends tini openssl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1001 nodegroup \
    && useradd -u 1001 -g nodegroup -s /bin/sh -M nodeuser \
    && chown -R nodeuser:nodegroup /app

COPY --chown=1001:1001 --from=builder /app/apps/livekit-agent/dist ./apps/livekit-agent/dist
COPY --chown=1001:1001 --from=builder /app/apps/livekit-agent/package.json ./apps/livekit-agent/package.json
COPY --chown=1001:1001 --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --chown=1001:1001 --from=builder /app/packages/shared/package.json ./packages/shared/package.json
COPY --chown=1001:1001 --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --chown=1001:1001 --from=builder /app/node_modules ./node_modules

USER nodeuser

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:8081/', (r) => r.statusCode === 200 ? process.exit(0) : process.exit(1)).on('error', () => process.exit(1))"

EXPOSE 8081

ENTRYPOINT ["tini", "--"]
CMD ["node", "apps/livekit-agent/dist/index.js", "start"]
