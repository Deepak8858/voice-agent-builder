# syntax=docker/dockerfile:1.7
# NODE PIN: keep in sync with the quality-gate workflows
# (.github/workflows/quality-gate.yml and .depot/workflows/quality-gate.yml),
# which set NODE_VERSION "22.22" and therefore resolve to the newest published
# 22.22.x. This image pins the same 22.22 line at an exact patch, because a
# production runtime should be byte-reproducible while a CI runner should pick
# up patch fixes automatically. Both sides satisfy the root package.json
# engines field ("^20.20.0 || >=22.22.0") via its >=22.22.0 arm, and the pinned
# patch also clears jsdom 30's ^22.22.2 floor — irrelevant here, since jsdom is
# only loaded by `vitest run` and no image stage invokes it, but it keeps the
# two pins interchangeable. Node 20 reached end-of-life on 2026-04-30, so do
# not move this back onto a 20.x tag.
FROM --platform=linux/amd64 node:22.22.3-bookworm-slim AS build

WORKDIR /app
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0

ARG NEXT_PUBLIC_API_URL
# The canonical public origin. Consumed by `lib/site-url.ts` for metadataBase,
# robots.txt and sitemap.xml, all of which are baked in at build time. Without
# this ARG the deploy workflow's --build-arg is silently discarded and those
# three advertise the localhost fallback to search engines.
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_DEMO_SHARE_PATH
ARG NEXT_PUBLIC_SALES_EMAIL

# PostHog browser analytics.
#
# These MUST be build args, not runtime env: Next.js inlines NEXT_PUBLIC_* into
# the client bundle at build time, so a value supplied only to the running
# container is never seen by the browser. Omitting them is a supported state —
# `posthogWebSettingsFromEnv` returns null and the SDK is never initialised —
# which is why they are deliberately absent from the require_arg checks below.
#
# The project token is a public, write-only key that ships in the client bundle
# by design; it is not a secret. The server-side tier reads its own
# POSTHOG_* vars at runtime and is unaffected by anything here.
ARG NEXT_PUBLIC_POSTHOG_ENABLED
ARG NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN
ARG NEXT_PUBLIC_POSTHOG_HOST
ARG NEXT_PUBLIC_APP_ENV
ARG NEXT_PUBLIC_APP_VERSION

# NEXT_PUBLIC_BILLING_MODE used to be required here and validated `demo|live`.
# Nothing reads it: `apps/web/lib/billing-mode.ts` was deleted and no NEXT_PUBLIC
# billing switch survives anywhere in apps/, so the value was inlined into the
# bundle and never consulted. Requiring it only implied a control that does not
# exist, and the same reasoning already retired the host-side BILLING_MODE check
# in .github/workflows/deploy-aws-ec2.yml. Checkout availability comes from the
# DODO_* configuration the API reads at runtime.
RUN require_arg() { eval "value=\${$1}"; test -n "$value" || { echo "Required build argument $1 is missing" >&2; exit 1; }; }; \
    require_arg NEXT_PUBLIC_API_URL; \
    require_arg NEXT_PUBLIC_APP_URL; \
    require_arg NEXT_PUBLIC_SUPABASE_URL; \
    require_arg NEXT_PUBLIC_SUPABASE_ANON_KEY

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY \
    NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY \
    NEXT_PUBLIC_DEMO_SHARE_PATH=$NEXT_PUBLIC_DEMO_SHARE_PATH \
    NEXT_PUBLIC_SALES_EMAIL=$NEXT_PUBLIC_SALES_EMAIL \
    NEXT_PUBLIC_POSTHOG_ENABLED=$NEXT_PUBLIC_POSTHOG_ENABLED \
    NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=$NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN \
    NEXT_PUBLIC_POSTHOG_HOST=$NEXT_PUBLIC_POSTHOG_HOST \
    NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV \
    NEXT_PUBLIC_APP_VERSION=$NEXT_PUBLIC_APP_VERSION

RUN corepack enable \
    && corepack prepare pnpm@10.33.2 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/livekit-agent/package.json apps/livekit-agent/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json

RUN --mount=type=cache,id=voiceforge-pnpm,target=/pnpm/store,sharing=locked \
    pnpm config set store-dir /pnpm/store --global \
    && pnpm install --frozen-lockfile --ignore-scripts --node-linker=hoisted

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/ui packages/ui
COPY apps/web apps/web

RUN pnpm --filter @voiceforge/shared run build
RUN --mount=type=cache,id=voiceforge-next,target=/app/apps/web/.next/cache,sharing=locked \
    pnpm --filter @voiceforge/web run build

FROM --platform=linux/amd64 node:22.22.3-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 voiceforge \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin voiceforge

COPY --from=build --chown=10001:10001 /app/apps/web/.next/standalone ./
COPY --from=build --chown=10001:10001 /app/apps/web/.next/static apps/web/.next/static
COPY --from=build --chown=10001:10001 /app/apps/web/public apps/web/public

USER voiceforge
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "const http=require('http');const r=http.get({host:'127.0.0.1',port:process.env.PORT||3000,path:'/api/health'},res=>{res.resume();process.exit(res.statusCode===200?0:1)});r.on('error',()=>process.exit(1));r.setTimeout(4000,()=>{r.destroy();process.exit(1)})"]
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "apps/web/server.js"]
