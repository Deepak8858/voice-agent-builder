# =============================================================================
# VoiceForge AI — Web Container (Next.js standalone)
# =============================================================================
# Build context: repository root (monorepo)
# Build args: NEXT_PUBLIC_* vars for build-time injection
#
# Installs with pnpm and a FROZEN lockfile. The security patches for transitive
# advisories (postcss, nanoid, ...) live in `pnpm.overrides` in the root
# package.json, which npm does not read. Installing with npm, or deleting the
# lockfile, ships an unpatched dependency graph that CI never audited.
# ---------------------------------------------------------------------------

FROM --platform=linux/amd64 node:20-slim AS builder
WORKDIR /app

# Build arguments for environment injection at build time
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
ENV NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY}
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}

# Pin pnpm via corepack; the version comes from packageManager in package.json.
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

# Copy the lockfile and every workspace manifest first, for layer caching and
# because --frozen-lockfile needs the complete set named by pnpm-workspace.yaml.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY apps/livekit-agent/package.json ./apps/livekit-agent/
COPY apps/voice-edge/package.json ./apps/voice-edge/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/ui/package.json ./packages/ui/

# Install from the lockfile. Fails loudly if package.json and pnpm-lock.yaml
# have drifted, keeping the shipped graph identical to the audited one.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store --global && \
    pnpm install --frozen-lockfile --ignore-scripts --node-linker=hoisted

# Copy source
COPY apps/web ./apps/web
COPY packages/shared ./packages/shared
COPY packages/ui ./packages/ui
COPY tsconfig.base.json ./

# Build shared packages then web
RUN pnpm --filter @voiceforge/shared run build
RUN --mount=type=cache,id=next-cache,target=/app/apps/web/.next/cache \
    pnpm --filter @voiceforge/web run build

# =============================================================================
# Production stage — minimal standalone runner
# =============================================================================
FROM --platform=linux/amd64 node:20-slim AS production

WORKDIR /app
ENV NODE_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1001 nodegroup \
    && useradd -u 1001 -g nodegroup -s /bin/sh -M nodeuser \
    && chown -R nodeuser:nodegroup /app

ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Copy ALL node_modules from builder (includes all monorepo deps, no npm ci needed)
COPY --chown=1001:1001 --from=builder /app/node_modules ./

# Copy standalone output from builder
COPY --chown=1001:1001 --from=builder /app/apps/web/.next/standalone ./
COPY --chown=1001:1001 --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --chown=1001:1001 --from=builder /app/apps/web/public ./apps/web/public

USER nodeuser

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:' + (process.env.PORT || 3000) + '/api/health', (r) => r.statusCode === 200 ? process.exit(0) : process.exit(1))"

ENTRYPOINT ["tini", "--"]
CMD ["node", "apps/web/server.js"]
