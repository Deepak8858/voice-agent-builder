# syntax=docker/dockerfile:1.7
FROM --platform=linux/amd64 node:20-bookworm-slim AS build

WORKDIR /app
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_BILLING_MODE
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_DEMO_SHARE_PATH
ARG NEXT_PUBLIC_SALES_EMAIL

RUN require_arg() { eval "value=\${$1}"; test -n "$value" || { echo "Required build argument $1 is missing" >&2; exit 1; }; }; \
    require_arg NEXT_PUBLIC_API_URL; \
    require_arg NEXT_PUBLIC_BILLING_MODE; \
    require_arg NEXT_PUBLIC_SUPABASE_URL; \
    require_arg NEXT_PUBLIC_SUPABASE_ANON_KEY; \
    case "$NEXT_PUBLIC_BILLING_MODE" in demo|live) ;; *) echo "NEXT_PUBLIC_BILLING_MODE must be demo or live" >&2; exit 1 ;; esac

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_BILLING_MODE=$NEXT_PUBLIC_BILLING_MODE \
    NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY \
    NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY \
    NEXT_PUBLIC_DEMO_SHARE_PATH=$NEXT_PUBLIC_DEMO_SHARE_PATH \
    NEXT_PUBLIC_SALES_EMAIL=$NEXT_PUBLIC_SALES_EMAIL

RUN corepack enable \
    && corepack prepare pnpm@10.33.2 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/livekit-agent/package.json apps/livekit-agent/package.json
COPY apps/voice-edge/package.json apps/voice-edge/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json

RUN --mount=type=cache,id=voiceforge-pnpm,target=/pnpm/store,sharing=locked \
    pnpm config set store-dir /pnpm/store --global \
    && pnpm install --frozen-lockfile --ignore-scripts --node-linker=hoisted

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY packages/ui packages/ui
COPY apps/web apps/web

RUN pnpm --filter @voiceforge/shared run build
RUN --mount=type=cache,id=voiceforge-next,target=/app/apps/web/.next/cache,sharing=locked \
    pnpm --filter @voiceforge/web run build

FROM --platform=linux/amd64 node:20-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 voiceforge \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin voiceforge

COPY --from=build --chown=10001:10001 /app/apps/web/.next/standalone ./
COPY --from=build --chown=10001:10001 /app/apps/web/.next/static apps/web/.next/static
COPY --from=build --chown=10001:10001 /app/apps/web/public apps/web/public

USER voiceforge
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "const http=require('http');const r=http.get({host:'127.0.0.1',port:process.env.PORT||3000,path:'/api/health'},res=>{res.resume();process.exit(res.statusCode===200?0:1)});r.on('error',()=>process.exit(1));r.setTimeout(4000,()=>{r.destroy();process.exit(1)})"]
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "apps/web/server.js"]
