# syntax=docker/dockerfile:1.7
# NODE PIN: deliberately still 20.20.0 while the quality-gate workflows run
# NODE_VERSION 22.22. The workflows had to move because jsdom 30 (apps/web's
# vitest DOM environment) needs node:worker_threads.markAsUncloneable, which
# does not exist before Node 22.10. No image runs the web test suite, so nothing
# here needs it, and re-basing a production runtime is riskier than re-basing
# CI. Both satisfy the root package.json engines ("^20.20.0 || >=22.22.0"), so
# this is a valid split rather than drift. Node 20 is end-of-life as of
# 2026-04-30 though, so these images still need their own bump.
FROM --platform=linux/amd64 node:20.20.0-bookworm-slim AS build

WORKDIR /app
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ openssl \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@10.33.2 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/livekit-agent/package.json apps/livekit-agent/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json

RUN --mount=type=cache,id=voiceforge-pnpm,target=/pnpm/store,sharing=locked \
    pnpm config set store-dir /pnpm/store --global \
    && pnpm install --frozen-lockfile --ignore-scripts --node-linker=hoisted

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/api apps/api

RUN pnpm exec prisma generate --schema=apps/api/prisma/schema.prisma \
    && pnpm --filter @voiceforge/shared run build \
    && pnpm --filter @voiceforge/api run build

FROM --platform=linux/amd64 node:20.20.0-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    API_PORT=4000

RUN apt-get update \
    && apt-get install -y --no-install-recommends tini openssl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 voiceforge \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin voiceforge

COPY --from=build --chown=10001:10001 /app/node_modules node_modules
# pnpm keeps the @voiceforge/shared workspace link, and any dependency it could
# not hoist to the root, in the package's own node_modules. Without this the
# runtime image has packages/shared/dist on disk but no resolvable
# @voiceforge/shared, and the API crashes on boot with MODULE_NOT_FOUND.
COPY --from=build --chown=10001:10001 /app/apps/api/node_modules apps/api/node_modules
COPY --from=build --chown=10001:10001 /app/apps/api/dist apps/api/dist
COPY --from=build --chown=10001:10001 /app/apps/api/package.json apps/api/package.json
COPY --from=build --chown=10001:10001 /app/apps/api/prisma apps/api/prisma
# The deploy workflow runs release verification (scripts/db-verify.ts) inside
# this image via the hoisted tsx binary. The script imports from src/db, so
# both directories must exist at runtime; there is no pnpm in this image.
COPY --from=build --chown=10001:10001 /app/apps/api/scripts apps/api/scripts
COPY --from=build --chown=10001:10001 /app/apps/api/src/db apps/api/src/db
COPY --from=build --chown=10001:10001 /app/packages/shared/dist packages/shared/dist
COPY --from=build --chown=10001:10001 /app/packages/shared/package.json packages/shared/package.json

USER voiceforge
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "const http=require('http');const r=http.get({host:'127.0.0.1',port:process.env.API_PORT||4000,path:'/api/v1/health'},res=>{res.resume();process.exit(res.statusCode===200?0:1)});r.on('error',()=>process.exit(1));r.setTimeout(4000,()=>{r.destroy();process.exit(1)})"]
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "apps/api/dist/main.js"]
