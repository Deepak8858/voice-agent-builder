# Canonical-host redirect: www is served from the same certificate (the
# incfrog.ai lineage includes www.incfrog.ai as a SAN) but all traffic is
# redirected to the apex so the application sees one origin.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.incfrog.ai;

    ssl_certificate /etc/letsencrypt/live/incfrog.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/incfrog.ai/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/incfrog.ai/chain.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://incfrog.ai$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name incfrog.ai;

    ssl_certificate /etc/letsencrypt/live/incfrog.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/incfrog.ai/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/incfrog.ai/chain.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Kept in sync with the same header in apps/web/next.config.ts. nginx's
    # add_header wins for what the client actually sees, so an omission here
    # silently drops a restriction the application believes it is sending.
    add_header Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=()" always;

    location = /nginx-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location ^~ /api/ {
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }

    # Caching for `public/` assets is deliberately set by the application
    # (apps/web/next.config.ts) rather than here. A `location` block with its
    # own `add_header` cancels inheritance of the server-level security headers
    # above, so caching those paths at this layer would silently strip HSTS and
    # the framing/-content-type protections from every static asset response.
    location / {
        proxy_pass http://web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }
}
